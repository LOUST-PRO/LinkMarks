#!/usr/bin/make -f
# Debhelper rules for linkmarks.
#
# Build flow:
#   1. cargo build --release (linkmarks-cli subcommand)
#   2. install binary to debian/linkmarks/usr/bin/
#   3. install manpage to debian/linkmarks/usr/share/man/man1/
#
# Notes:
#   - Use `--buildsystem cargo` (the modern dh-cargo hook), not the
#     deprecated `--with cargo`. The latter is the legacy compat
#     shim and emits warnings on recent debhelper.
#   - Honour `DEB_BUILD_OPTIONS=nocheck` — dpkg-buildpackage passes
#     that when the user wants to skip the test phase. We default
#     to skip because upstream CI runs the same matrix; rebuilding
#     on every dpkg-buildpackage is duplicate compute.

%:
	dh $@ --buildsystem cargo

override_dh_auto_build:
	cargo build --release --bin linkmarks

override_dh_auto_install:
	# Binary
	install -Dm 0755 target/release/linkmarks \
	  debian/linkmarks/usr/bin/linkmarks
	# Manpage (built upstream via `cargo build` runs roff generation;
	# downstream can swap this for a `pandoc` conversion if preferred)
	if [ -f docs/man/linkmarks.1 ]; then \
	  install -Dm 0644 docs/man/linkmarks.1 \
	    debian/linkmarks/usr/share/man/man1/linkmarks.1; \
	  gzip -9n debian/linkmarks/usr/share/man/man1/linkmarks.1; \
	fi

override_dh_auto_test:
	# Honour the upstream-style convention: skip tests unless the
	# packager explicitly opts in via `DEB_BUILD_OPTIONS=nocheck` —
	# which means "I want tests skipped". Inversely, if the user
	# does NOT set nocheck, run the full test suite.
	ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
		@echo "DEB_BUILD_OPTIONS=nocheck set — skipping linkmarks tests"
	else
		cargo test --workspace --release
	endif
