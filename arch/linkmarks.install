# linkmarks.install — pacman install hook (downstream stub).
#
# Pacman calls these scripts as `pre_install`, `post_install`,
# `pre_upgrade`, `post_upgrade`, etc. Here is the convention:
#
#  - `pre_install`:  preparation that does NOT depend on the new
#                    version's files being in place yet.
#  - `post_install`: deferred work that DOES depend on the new
#                    version (e.g. compiling man db, generating
#                    completion files via the new binary).
#  - `pre_upgrade` / `post_upgrade`: same as above for upgrades.
#
# Most of what you might want to do here — `install -d` on the XDG
# dirs, `mandb --quiet`, `update-desktop-database` if a .desktop is
# shipped — is already covered by other tools. The only thing we
# document here is the **completion install** flow:

post_install() {
  cat <<'EOF'
==> LinkMarks shell completions
    Shell completions are generated on first use via the binary:
      linkmarks completions bash > /usr/share/bash-completion/completions/linkmarks
      linkmarks completions zsh  > /usr/share/zsh/site-functions/_linkmarks
      linkmarks completions fish > /usr/share/fish/vendor_completions.d/linkmarks.fish
    Re-run after a major upgrade if you customise arguments.
EOF
}

post_upgrade() {
  post_install
}
